{
  "manifest_version": 3,
  "name": "Eyentra Capture",
  "version": "1.0.0",
  "description": "Capture a selected browser area and upload it to Eyentra.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "action": {
    "default_title": "Capture to Eyentra"
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
